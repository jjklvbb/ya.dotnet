{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "EventsDb": "Host=localhost;Port=5434;Database=eventsdb;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "EventApi",
    "Audience": "EventApiClient",
    "LifetimeMinutes": 30
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "events-booking-consumer"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "EventTtlMinutes": 5,
    "TopEventsTtlSeconds": 30
  }
}